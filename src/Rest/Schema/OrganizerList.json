{
	"description": "Paginated list of event organizers",
	"type": "array",
	"items": {
		"type": "object",
		"required": [
			"organizer_id",
			"user_id",
			"user_name",
			"roles",
			"user_page"
		],
		"properties": {
			"organizer_id": {
				"type": "integer",
				"description": "Organizer record ID. Pass this as `last_organizer_id` to retrieve the next page.",
				"example": 7
			},
			"user_id": {
				"type": "integer",
				"description": "Organizer's global central user ID",
				"example": 12345
			},
			"user_name": {
				"type": "string",
				"description": "Organizer's username",
				"example": "ExampleUser"
			},
			"roles": {
				"type": "array",
				"description": "Organizer's roles for the event",
				"items": {
					"type": "string"
				},
				"example": [
					"organizer"
				]
			},
			"user_page": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"description": "URL of the user page"
					},
					"title": {
						"type": "string",
						"description": "Link text for the user page"
					},
					"classes": {
						"type": "string",
						"description": "CSS classes for the user page link, as generated by core"
					}
				},
				"description": "Link data for the organizer's user page"
			}
		}
	}
}
