{
	"mwapi": "1.1.0",
	"moduleId": "campaignevents/v0",
	"info": {
		"title": "CampaignEvents API",
		"version": "0.1.0",
		"description": "REST API for the CampaignEvents extension, which enables organizers to create and manage campaign events, invite and track participants, and associate wiki contributions with events.",
		"contact": {
			"name": "WMF Connection Team",
			"url": "https://meta.wikimedia.org/wiki/Connection_Team"
		},
		"license": {
			"name": "GNU General Public License 2.0 or later",
			"url": "https://www.gnu.org/licenses/old-licenses/gpl-2.0.html"
		},
		"termsOfService": "https://foundation.wikimedia.org/wiki/Special:MyLanguage/Policy:Terms_of_Use#12._API_Terms"
	},
	"externalDocs": {
		"description": "CampaignEvents extension documentation",
		"url": "https://www.mediawiki.org/wiki/Extension:CampaignEvents"
	},
	"tags": [
		{
			"name": "Events",
			"description": "Operations for creating and managing event registrations."
		},
		{
			"name": "Participants",
			"description": "Operations for managing event participants."
		},
		{
			"name": "Organizers",
			"description": "Operations for managing event organizers."
		},
		{
			"name": "Contributions",
			"description": "Operations for managing event contribution records."
		},
		{
			"name": "Worklists",
			"description": "Operations for managing worklists."
		},
		{
			"name": "Utilities",
			"description": "Utility operations."
		}
	],
	"paths": {
		"/event_registration": {
			"post": {
				"operationId": "createEventRegistration",
				"summary": "Create event registration",
				"x-i18n-description": "campaignevents-rest-create-registration-desc",
				"tags": [ "Events" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\EnableEventRegistrationHandler",
					"services": [
						"CampaignEventsEventFactory",
						"CampaignEventsPermissionChecker",
						"CampaignEventsEditEventCommand",
						"CampaignEventsOrganizersStore",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsEventQuestionsRegistry",
						"CampaignEventsWikiLookup",
						"CampaignEventsTopicRegistry",
						"CampaignEventsEventTypesRegistry",
						"CampaignEventsCountryProvider"
					]
				}
			}
		},
		"/event_registration/{id}": {
			"get": {
				"operationId": "getEventRegistration",
				"summary": "Get event registration",
				"x-i18n-description": "campaignevents-rest-get-registration-desc",
				"tags": [ "Events" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetEventRegistrationHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsTrackingToolRegistry",
						"CampaignEventsPermissionChecker",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsOrganizersStore",
						"CampaignEventsParticipantsStore"
					]
				}
			},
			"put": {
				"operationId": "updateEventRegistration",
				"summary": "Update event registration",
				"x-i18n-description": "campaignevents-rest-update-registration-desc",
				"tags": [ "Events" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\UpdateEventRegistrationHandler",
					"services": [
						"CampaignEventsEventFactory",
						"CampaignEventsPermissionChecker",
						"CampaignEventsEditEventCommand",
						"CampaignEventsOrganizersStore",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsEventQuestionsRegistry",
						"CampaignEventsWikiLookup",
						"CampaignEventsTopicRegistry",
						"CampaignEventsEventTypesRegistry",
						"CampaignEventsEventLookup",
						"CampaignEventsCountryProvider"
					]
				}
			},
			"delete": {
				"operationId": "deleteEventRegistration",
				"summary": "Delete event registration",
				"x-i18n-description": "campaignevents-rest-delete-registration-desc",
				"tags": [ "Events" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\DeleteEventRegistrationHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsDeleteEventCommand"
					]
				}
			}
		},
		"/event_registration/{id}/participants/self": {
			"put": {
				"operationId": "registerForEvent",
				"summary": "Register current user for event",
				"x-i18n-description": "campaignevents-rest-register-for-event-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\RegisterForEventHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsRegisterParticipantCommand",
						"CampaignEventsEventQuestionsRegistry",
						"CampaignEventsParticipantsStore",
						"CampaignEventsCentralUserLookup"
					]
				}
			},
			"delete": {
				"operationId": "cancelOwnEventRegistration",
				"summary": "Cancel own event registration",
				"x-i18n-description": "campaignevents-rest-cancel-own-registration-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\CancelEventRegistrationHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsUnregisterParticipantCommand"
					]
				}
			},
			"get": {
				"operationId": "getOwnRegistrationInfo",
				"summary": "Get own registration info",
				"x-i18n-description": "campaignevents-rest-get-own-registration-info-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetOwnRegistrationInfoHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsParticipantsStore",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsEventQuestionsRegistry"
					]
				}
			}
		},
		"/event_registration/{id}/organizers": {
			"get": {
				"operationId": "listEventOrganizers",
				"summary": "List event organizers",
				"x-i18n-description": "campaignevents-rest-event-list-organizers-desc",
				"tags": [ "Organizers" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListOrganizersHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsOrganizersStore",
						"CampaignEventsRoleFormatter",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsUserLinker"
					]
				}
			},
			"put": {
				"operationId": "setEventOrganizers",
				"summary": "Set event organizers",
				"x-i18n-description": "campaignevents-rest-event-set-organizers-desc",
				"tags": [ "Organizers" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\SetOrganizersHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsEditEventCommand"
					]
				}
			}
		},
		"/event_registration/{id}/participants": {
			"get": {
				"operationId": "listEventParticipants",
				"summary": "List event participants",
				"x-i18n-description": "campaignevents-rest-event-list-participants-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListParticipantsHandler",
					"services": [
						"CampaignEventsPermissionChecker",
						"CampaignEventsEventLookup",
						"CampaignEventsParticipantsStore",
						"CampaignEventsCentralUserLookup",
						"CampaignEventsUserLinker",
						"UserFactory",
						"CampaignEventsUserMailer",
						"CampaignEventsEventQuestionsRegistry",
						"MessageFormatterFactory"
					]
				}
			},
			"delete": {
				"operationId": "removeEventParticipants",
				"summary": "Remove participants from event",
				"x-i18n-description": "campaignevents-rest-event-remove-participants-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\RemoveParticipantsFromEventHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsUnregisterParticipantCommand"
					]
				}
			}
		},
		"/organizer/{userid}/event_registrations": {
			"get": {
				"operationId": "listEventsByOrganizer",
				"summary": "List events by organizer",
				"x-i18n-description": "campaignevents-rest-list-events-by-organizer-desc",
				"tags": [ "Organizers" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListEventsByOrganizerHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsCentralUserLookup"
					]
				}
			}
		},
		"/participant/{userid}/event_registrations": {
			"get": {
				"operationId": "listEventsByParticipant",
				"summary": "List events by participant",
				"x-i18n-description": "campaignevents-rest-list-events-by-participant-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListEventsByParticipantHandler",
					"services": [
						"CampaignEventsEventLookup",
						"CampaignEventsCentralUserLookup"
					]
				}
			}
		},
		"/participant/self/events_for_edit": {
			"get": {
				"operationId": "listOwnEventsForEdit",
				"summary": "List events for contribution association",
				"x-i18n-description": "campaignevents-rest-list-own-events-for-edit-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListOwnEventsForEditHandler",
					"services": [
						"CampaignEventsCentralUserLookup",
						"CampaignEventsEventLookup",
						"CampaignEventsGoalProgressFormatter",
						"CampaignEventsWorklistEventsStore",
						"TitleFormatter"
					]
				}
			}
		},
		"/event_registration/{id}/email": {
			"post": {
				"operationId": "emailEventParticipants",
				"summary": "Send email to event participants",
				"x-i18n-description": "campaignevents-rest-email-participants-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\EmailUsersHandler",
					"services": [
						"CampaignEventsPermissionChecker",
						"CampaignEventsUserMailer",
						"CampaignEventsParticipantsStore",
						"CampaignEventsEventLookup"
					]
				}
			}
		},
		"/participant_questions": {
			"get": {
				"operationId": "getParticipantQuestions",
				"summary": "Get participant questions",
				"x-i18n-description": "campaignevents-rest-get-participant-questions-desc",
				"tags": [ "Participants" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetParticipantQuestionsHandler",
					"services": [
						"CampaignEventsEventQuestionsRegistry",
						"MessageFormatterFactory",
						"ContentLanguage"
					]
				}
			}
		},
		"/formatted_time/{languageCode}/{start}/{end}": {
			"get": {
				"operationId": "getFormattedTime",
				"summary": "Get localised time strings for date range",
				"x-i18n-description": "campaignevents-rest-get-formatted-time-desc",
				"tags": [ "Utilities" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetFormattedTimeHandler",
					"services": [
						"LanguageFactory",
						"LanguageNameUtils"
					]
				}
			}
		},
		"/event_registration/{id}/edits/{wiki}/{revid}": {
			"put": {
				"operationId": "associateRevisionWithEvent",
				"summary": "Associate revision with event",
				"x-i18n-description": "campaignevents-rest-associate-revision-with-event-desc",
				"tags": [ "Contributions" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\EventContributionsHandler",
					"services": [
						"CampaignEventsEventContributionValidator",
						"CampaignEventsWikiLookup",
						"CampaignEventsEventLookup"
					]
				}
			}
		},
		"/event_contributions/{id}": {
			"delete": {
				"operationId": "deleteEventContribution",
				"summary": "Delete event contribution record",
				"x-i18n-description": "campaignevents-rest-delete-event-contribution-desc",
				"tags": [ "Contributions" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\DeleteEventContributionHandler",
					"services": [
						"CampaignEventsEventContributionStore",
						"CampaignEventsPermissionChecker",
						"CampaignEventsEventLookup"
					]
				}
			}
		},
		"/worklist/{title}/pages": {
			"patch": {
				"summary": "Add or remove worklist pages",
				"x-i18n-description": "campaignevents-rest-patch-worklist-pages-desc",
				"tags": [ "Worklists" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\PatchWorklistPagesHandler",
					"services": [
						"CampaignEventsWorklistArticleHelper"
					]
				}
			}
		},
		"/worklist/{wiki}/{namespace}/{title}/pages": {
			"get": {
				"summary": "List the pages in an event's worklist",
				"x-i18n-description": "campaignevents-rest-get-worklist-pages-desc",
				"tags": [ "Worklists" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetWorklistPagesHandler",
					"services": [
						"MainConfig",
						"PageStoreFactory",
						"CampaignEventsWikiLookup",
						"TitleFactory",
						"LinkBatchFactory",
						"LinkRendererFactory",
						"CampaignEventsWorklistPagesLookupFactory"
					]
				}
			}
		},
		"/worklist/{worklistwiki}/{namespace}/{title}/pages/quality": {
			"get": {
				"summary": "Quality scores for pages in an event's worklist",
				"x-i18n-description": "campaignevents-rest-get-worklist-pages-quality-desc",
				"tags": [ "Worklists" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\GetWorklistPagesQualityHandler",
					"services": [
						"MainConfig",
						"PageStoreFactory",
						"CampaignEventsWorklistPagesLookupFactory",
						"CampaignEventsArticleQualityLookup",
						"CampaignEventsWikiLookup"
					]
				}
			}
		},
		"/event_discovery/discoverable_events": {
			"get": {
				"summary": "List discoverable events for a page",
				"x-i18n-description": "campaignevents-rest-list-discoverable-events-desc",
				"tags": [ "Worklists" ],
				"handler": {
					"class": "MediaWiki\\Extension\\CampaignEvents\\Rest\\ListDiscoverableEventsForPageHandler",
					"services": [
						"CampaignEventsCentralUserLookup",
						"TitleFormatter",
						"CampaignEventsDiscoverableEventsLookup"
					]
				}
			}
		}
	}
}
